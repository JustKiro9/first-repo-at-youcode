for (let i = 100; i <= 999; i++) {
  // Extraire les trois chiffres
  let centaines = Math.floor(i / 100);
  let dizaines = Math.floor((i % 100) / 10);
  let unites = i % 10;

  // Calculer la somme des cubes
  let sommeCubes = centaines ** 3 + dizaines ** 3 + unites ** 3;

  // Vérifier si le nombre est un nombre d'Armstrong
  if (sommeCubes === i) {
    console.log(i);
  }
}
